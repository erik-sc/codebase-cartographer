{
  "$comment": "Copy to <your-repo>/.claude/settings.json (or merge). Grants exactly what the cartographer skills need and nothing else: read-only tools, read-only git, the two bundled scripts, and writes limited to docs/codebase-knowledge/. 'allow' rules only take effect after you accept the workspace-trust dialog once; 'deny' rules apply immediately and always win over 'allow'.",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Agent",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(git ls-files *)",
      "Bash(git shortlog *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git branch --list *)",
      "Bash(git tag --list *)",
      "Bash(git tag --sort *)",
      "Bash(git describe *)",
      "Bash(git cat-file *)",
      "Bash(git grep *)",
      "Bash(rg *)",
      "Bash(tree *)",
      "Bash(tokei *)",
      "Bash(cloc *)",
      "Bash(python * repo_skeleton.py *)",
      "Bash(python * kb_lint.py *)",
      "Bash(python3 * repo_skeleton.py *)",
      "Bash(python3 * kb_lint.py *)",
      "Write(./docs/codebase-knowledge/**)",
      "Edit(./docs/codebase-knowledge/**)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git stash push *)",
      "Bash(git stash pop *)",
      "Bash(git stash drop *)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(mv *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  }
}
